<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_form_card_payment_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.card.payment.inherit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="replaced_by_card_reader"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_search_card_payment_inherit" model="ir.ui.view">
        <field name="name">pos.payment.search.card.payment.inherit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter name="card_contingency" string="Cobrado en contingencia"
                        domain="[('card_contingency', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="card_contingency_log_view_list" model="ir.ui.view">
        <field name="name">card.contingency.log.list</field>
        <field name="model">card.contingency.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="activated_by_id"/>
                <field name="activated_date"/>
                <field name="deactivated_by_id"/>
                <field name="deactivated_date"/>
                <field name="closed_with_session"/>
            </list>
        </field>
    </record>

    <record id="card_contingency_log_action" model="ir.actions.act_window">
        <field name="name">Modo contingencia</field>
        <field name="res_model">card.contingency.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="card_contingency_log_menu"
              name="Modo contingencia"
              parent="point_of_sale.menu_point_rep"
              action="card_contingency_log_action"
              sequence="40"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
